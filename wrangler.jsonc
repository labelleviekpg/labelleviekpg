{
  // Le site public de La Belle Vie. Pages statiques dans public/,
  // une seule route de code pour le formulaire de contact.
  "name": "labelleviekpg",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Sans ceci, Cloudflare sert les fichiers statiques sans jamais appeler le
    // code : ni la balise canonical ni les en-tetes de cache ne passaient.
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "labelleviekpg", "database_id": "53700590-1e9e-4797-9e2c-51c0d82314f6" }
  ],
  // Le calculateur de privatisation tourne dans son propre Worker. On lui
  // parle par liaison de service, sans sortir sur le reseau public.
  "services": [
    { "binding": "MOTEUR", "service": "labellevie" }
  ],
  "vars": {
    "CONTACT_VERS": "events@labelleviekpg.com"
  }
}
